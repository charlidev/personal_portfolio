---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectTabs from './ProjectTabs.astro';
import { getCopy, type Locale } from '../i18n';
import { olistProjectCopy } from '../i18n/olistProject';
import { crmProjectCopy } from '../i18n/crmProject';
import { aiJobImpactCopy } from '../i18n/aiJobImpactProject';

interface Props { locale: Locale; project?: 'olist' | 'crm-marketing' | 'ai-job-impact' }
const { locale, project = 'olist' } = Astro.props;
const copy = project === 'ai-job-impact'
  ? aiJobImpactCopy[locale]
  : project === 'crm-marketing'
    ? crmProjectCopy[locale]
    : olistProjectCopy[locale];
const siteCopy = getCopy(locale);
const projectSlug = project;
const spanishPath = `/proyectos/${projectSlug}/`;
const englishPath = `/en/projects/${projectSlug}/`;
const canonicalPath = locale === 'es' ? spanishPath : englishPath;
const otherLanguagePath = locale === 'es' ? englishPath : spanishPath;
const projectsPath = locale === 'es' ? '/#proyectos' : '/en/#proyectos';
const description = copy.subtitle;
---

<BaseLayout
  locale={locale}
  title={`${copy.title} | ${siteCopy.documentTitle}`}
  description={description}
  canonicalPath={canonicalPath}
  spanishAlternatePath={spanishPath}
  englishAlternatePath={englishPath}
>
  <header class="detail-navigation">
    <nav class="container nav-inner" aria-label={copy.projectNavigationLabel}>
      <a class="back-link" href={projectsPath}><span aria-hidden="true">←</span> {copy.backToProjects}</a>
      <a class="language-link" href={otherLanguagePath} aria-label={copy.languageSwitchLabel}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
        </svg>
        <span>{locale === 'es' ? 'EN' : 'ES'}</span>
      </a>
    </nav>
  </header>

  <main class="container project-detail">
    <section class="project-heading" aria-labelledby="project-title">
      <div class="project-title-block">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 id="project-title">{copy.title}</h1>
        <p class="project-subtitle">{copy.subtitle}</p>
      </div>
      <span class="database-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" focusable="false">
          <ellipse cx="32" cy="13" rx="20" ry="8" />
          <path d="M12 13v14c0 4.4 9 8 20 8s20-3.6 20-8V13M12 27v14c0 4.4 9 8 20 8s20-3.6 20-8V27M12 41v10c0 4.4 9 8 20 8s20-3.6 20-8V41" />
        </svg>
      </span>
    </section>

    <section class="summary-card" aria-labelledby="summary-title">
      <div class="summary-heading">
        <span class="summary-mark" aria-hidden="true">01</span>
        <h2 id="summary-title">{copy.summaryTitle}</h2>
      </div>
      <p class="summary-lead">{copy.summary}</p>
      <p>{copy.technicalSummary}</p>
      <div class="technology-row">
        <span class="eyebrow">{copy.technologyLabel}</span>
        <ul class="technology-list" aria-label={copy.technologyLabel}>
          {copy.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </div>
      {copy.repositoryUrl && copy.repositoryLinkLabel && (
        <a class="repository-link" href={copy.repositoryUrl} target="_blank" rel="noopener noreferrer">{copy.repositoryLinkLabel} <span aria-hidden="true">↗</span></a>
      )}
    </section>

    <ProjectTabs copy={copy} />
  </main>

  <footer class="container detail-footer"><p>{copy.footer}</p></footer>
</BaseLayout>

<style>
  .detail-navigation {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }
  .nav-inner { display: flex; min-height: var(--header-height); align-items: center; justify-content: space-between; gap: 1rem; }
  .back-link, .language-link { color: var(--color-text-muted); text-decoration: none; }
  .back-link:hover, .language-link:hover { color: var(--color-text); }
  .language-link { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-mono); font-size: var(--text-sm); }
  .language-link svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.5; }

  .project-detail { padding-top: clamp(2.5rem, 7vw, 5rem); }
  .project-heading { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .project-title-block { max-width: 58rem; }
  .project-heading h1 { margin: 0.75rem 0 0; font-size: var(--text-3xl); line-height: 1.15; letter-spacing: -0.035em; }
  .project-subtitle { max-width: 68ch; margin: 1rem 0 0; color: var(--color-text-muted); font-size: var(--text-lead); }
  .database-mark { display: grid; width: 4.5rem; height: 4.5rem; flex: 0 0 auto; place-items: center; border: 1px solid var(--color-border); border-radius: 50%; background: rgb(11 83 81 / 28%); color: var(--color-accent); }
  .database-mark svg { width: 2.4rem; height: 2.4rem; fill: none; stroke: currentColor; stroke-width: 2.2; }

  .summary-card { margin-bottom: 3rem; padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: rgb(11 83 81 / 22%); }
  .summary-heading { display: flex; align-items: center; gap: 0.85rem; }
  .summary-heading h2 { margin: 0; font-size: var(--text-xl); }
  .summary-mark { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border: 1px solid var(--color-accent); border-radius: 50%; color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-xs); }
  .summary-card > p { color: var(--color-text-muted); }
  .summary-card .summary-lead { color: var(--color-text); font-size: var(--text-lg); }
  .technology-row { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem 1rem; margin-top: 1.5rem; }
  .technology-row > .eyebrow { padding-top: 0.3rem; }
  .technology-list { display: flex; flex: 1 1 30rem; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .technology-list li { padding: 0.2rem 0.6rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-highlight); font-family: var(--font-mono); font-size: var(--text-xs); }
  .repository-link { display: inline-block; margin-top: 1.25rem; font-family: var(--font-mono); font-size: var(--text-sm); text-decoration: none; }
  .repository-link:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .detail-footer { margin-top: 4rem; padding-block: 1.5rem 2.5rem; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font-size: var(--text-sm); }
  .detail-footer p { margin: 0; }

  @media (max-width: 38rem) {
    .nav-inner { min-height: 3.75rem; }
    .back-link { font-size: var(--text-sm); }
    .project-heading { align-items: flex-start; }
    .database-mark { width: 3.25rem; height: 3.25rem; }
    .database-mark svg { width: 1.8rem; height: 1.8rem; }
    .summary-card { margin-bottom: 2.25rem; }
    .technology-row { display: block; }
    .technology-list { margin-top: 0.65rem; }
  }
</style>
