---
import SectionHeading from './SectionHeading.astro';
import { contactMethods } from '../data/portfolio';
---

<section id="contacto" class="content-section container" aria-labelledby="contact-title">
  <SectionHeading id="contact-title" eyebrow="Conversemos" title="Contacto" />
  <ul class="contact-list">
    {contactMethods.map((contact) => (
      <li>
        <span>{contact.label}</span>
        {contact.href ? (
          <a class="contact-link" href={contact.href}>{contact.value}</a>
        ) : (
          <span class="pending">{contact.value}</span>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .content-section {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-border);
  }

  .contact-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--component-gap);
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pending {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .contact-link {
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    .contact-list {
      grid-template-columns: 1fr;
    }
  }
</style>
