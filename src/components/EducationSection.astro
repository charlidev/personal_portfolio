---
import SectionHeading from './SectionHeading.astro';
import { educationEntries } from '../data/portfolio';
---

<section id="formacion" class="content-section container" aria-labelledby="education-title">
  <SectionHeading
    id="education-title"
    eyebrow="Aprendizaje"
    title="Formación y certificaciones"
  />
  <div class="education-content">
    <div class="academic-group">
      <h3 class="academic-heading">Formación académica</h3>
      <ol class="education-list">
        {educationEntries.map((entry, index) => (
          <li class:list={['education-entry', index === 0 && 'featured']}>
            <div class="education-copy">
              <p class="education-level">{entry.level}</p>
              <h4>{entry.institution}</h4>
              <div class="program-row">
                <p class="program">{entry.program}</p>
                {entry.status && <span class="status">{entry.status}</span>}
              </div>
            </div>
            <div class="education-meta">
              <span class="period">{entry.period}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <ul class="placeholder-list" aria-label="Certificaciones y cursos">
      <li>
        <h3>Certificaciones</h3>
        <span class="pending">[Contenido pendiente]</span>
      </li>
      <li>
        <h3>Cursos</h3>
        <span class="pending">[Contenido pendiente]</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .content-section {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-border);
  }

  .education-content {
    margin-top: 2.5rem;
  }

  .placeholder-list,
  .education-list {
    padding: 0;
    list-style: none;
  }

  .placeholder-list {
    margin: 2.5rem 0 0;
  }

  .placeholder-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--component-gap);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-border);
  }

  .placeholder-list h3 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
  }

  .pending {
    color: var(--color-text-muted);
    text-align: right;
    font-size: var(--text-sm);
  }

  .academic-group {
    margin-top: 0;
  }

  .academic-heading {
    margin: 0 0 0.5rem;
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 550;
  }

  .education-list {
    margin: 0;
  }

  .education-entry {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--component-gap);
    padding-block: 1.5rem;
  }

  .education-entry.featured {
    padding-block: 1.75rem;
  }

  .education-list > .education-entry:first-child {
    border-bottom: 1px solid var(--color-border);
  }

  .education-copy {
    min-width: 0;
  }

  .education-level {
    margin: 0 0 0.35rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .education-copy h4 {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 550;
    line-height: 1.4;
  }

  .featured .education-copy h4 {
    font-size: var(--text-xl);
  }

  .program-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .program {
    margin: 0.4rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .education-meta {
    display: flex;
    flex: 0 0 auto;
    align-items: flex-end;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.1rem;
  }

  .period {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .status {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-highlight);
    font-size: var(--text-xs);
  }

  @media (max-width: 38rem) {
    .placeholder-list li,
    .education-entry {
      flex-direction: column;
      gap: 0.35rem;
    }

    .education-meta {
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
      padding-top: 0;
    }

    .period {
      white-space: normal;
    }
  }
</style>
