---
import type { OlistProjectCopy } from '../i18n/olistProject';

interface Props {
  title: string;
  description: string;
  labels: NonNullable<OlistProjectCopy['ferreteriaDiagramLabels']>;
}

const { title, description, labels } = Astro.props;
const flow = [
  labels.localFiles,
  labels.adls,
  labels.autoLoader,
  labels.bronze,
  labels.silver,
  labels.gold,
];
---

<figure class="architecture-diagram" aria-labelledby="ferreteria-diagram-title">
  <figcaption>
    <h3 id="ferreteria-diagram-title">{title}</h3>
    <p>{description}</p>
  </figcaption>

  <div class="generation-stage">
    <div class="generator-node">
      <span class="flow-index" aria-hidden="true">01</span>
      <strong>{labels.source}</strong>
    </div>
    <span class="generation-arrow" aria-hidden="true">↓</span>
    <div class="source-groups" aria-label={labels.source}>
      <section class="source-group">
        <h4>{labels.catalogGroupTitle} · {labels.catalogSources.length}</h4>
        <ul>{labels.catalogSources.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="source-group">
        <h4>{labels.transactionGroupTitle} · {labels.transactionSources.length}</h4>
        <ul>{labels.transactionSources.map((item) => <li>{item}</li>)}</ul>
      </section>
    </div>
  </div>

  <div class="pipeline-details">
    <div class="flow-with-unity">
      <ol class="flow-row" aria-label={title}>
        {flow.map((step, index) => (
          <li class="flow-step">
            <span class="flow-index" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
            <span class="flow-label">{step}</span>
            {index < flow.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
      <aside class="unity-note">
        <h4>{labels.unityCatalogTitle}</h4>
        <ul>{labels.environments.map((environment) => <li><code>{environment}</code></li>)}</ul>
      </aside>
    </div>

    <div class="layer-details">
      <section class="layer-detail">
        <h4>{labels.silver}</h4>
        <ul>{labels.silverOps.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="layer-detail gold-detail">
        <h4>{labels.gold}</h4>
        <ul>{labels.goldOutputs.map((item) => <li>{item}</li>)}</ul>
      </section>
    </div>
  </div>

</figure>

<style>
  .architecture-diagram {
    margin: 2.5rem 0 0;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-content-card-background);
    box-shadow: var(--color-card-shadow);
  }

  figcaption h3 { margin: 0; font-size: var(--text-lg); }
  figcaption p { max-width: 72ch; margin: 0.55rem 0 0; color: var(--color-text-muted); }

  .generation-stage {
    max-width: 50rem;
    margin: 1.25rem auto 0;
  }

  .generator-node {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-summary-background);
  }
  .generator-node strong { font-size: var(--text-sm); }
  .generation-arrow { display: block; margin: 0.25rem 0; color: var(--color-accent); text-align: center; }

  .source-groups, .layer-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0;
  }

  .source-group, .layer-detail {
    min-width: 0;
    padding: 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-card-background);
  }

  .source-group h4, .layer-detail h4, .unity-note h4 {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .source-group ul, .layer-detail ul, .unity-note ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
  }

  .source-group li, .layer-detail li {
    padding: 0.22rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .flow-with-unity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.28fr);
    gap: 0.75rem;
  }

  .pipeline-details {
    display: grid;
    row-gap: 1.125rem;
    margin-top: 0.75rem;
  }

  .flow-row {
    display: flex;
    align-items: stretch;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-step {
    position: relative;
    display: flex;
    min-width: 0;
    flex: 1 1 0;
    flex-direction: column;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-summary-background);
  }

  .flow-step:last-child { border-color: var(--color-accent); }
  .flow-index { color: var(--color-secondary); font-family: var(--font-mono); font-size: var(--text-xs); }
  .flow-label { color: var(--color-text); font-size: var(--text-xs); font-weight: 600; overflow-wrap: anywhere; }
  .flow-arrow { position: absolute; z-index: 1; top: 50%; right: -0.55rem; color: var(--color-accent); font-size: var(--text-sm); transform: translate(50%, -50%); }

  .layer-detail { border-left: 2px solid var(--color-secondary); }
  .gold-detail { border-left-color: var(--color-accent); }
  .layer-detail li { overflow-wrap: anywhere; }

  .unity-note { align-self: stretch; padding: 0.85rem; border-left: 1px solid var(--color-border); }
  .unity-note ul { gap: 0.5rem; }
  .unity-note code { color: var(--color-inline-code); font-family: var(--font-mono); font-size: var(--text-xs); overflow-wrap: anywhere; }

  @media (max-width: 54rem) {
    .flow-with-unity { grid-template-columns: 1fr; }
    .flow-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .unity-note { padding-inline: 0; border-top: 1px solid var(--color-border); border-left: 0; }
    .flow-arrow { display: none; }
  }

  @media (max-width: 38rem) {
    .source-groups, .layer-details { grid-template-columns: 1fr; }
    .flow-row { grid-template-columns: 1fr; gap: 0.6rem; }
    .flow-step { min-height: 3.2rem; }
  }
</style>
