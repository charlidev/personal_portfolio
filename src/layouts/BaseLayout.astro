---
import '../styles/global.css';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  canonicalPath?: string;
  spanishAlternatePath?: string;
  englishAlternatePath?: string;
}

const {
  locale,
  title,
  description,
  canonicalPath: customCanonicalPath,
  spanishAlternatePath: customSpanishPath,
  englishAlternatePath: customEnglishPath,
} = Astro.props;
const isEnglish = locale === 'en';
const canonicalPath = customCanonicalPath ?? (isEnglish ? '/en/' : '/');
const spanishAlternatePath = customSpanishPath ?? '/';
const englishAlternatePath = customEnglishPath ?? '/en/';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#092327" />
    <link rel="canonical" href={canonicalPath} />
    <link rel="alternate" hreflang="es" href={spanishAlternatePath} />
    <link rel="alternate" hreflang="en" href={englishAlternatePath} />
    <link rel="alternate" hreflang="x-default" href={spanishAlternatePath} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
