---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Portafolio | Ingeniería de Datos',
  description = 'Portafolio profesional de Ingeniería de Datos. Contenido en preparación.',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#092327" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
