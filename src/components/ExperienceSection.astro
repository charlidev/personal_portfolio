---
import SectionHeading from './SectionHeading.astro';
import { pulqueLabsExperience } from '../data/portfolio';
---

<section id="experiencia" class="content-section container" aria-labelledby="experience-title">
  <SectionHeading id="experience-title" eyebrow="Trayectoria" title="Experiencia" />

  <article class="experience-entry" aria-labelledby="pulquelabs-role">
    <header class="experience-header">
      <p class="eyebrow">PRÁCTICAS PROFESIONALES</p>
      <h3 id="pulquelabs-role">{pulqueLabsExperience.role}</h3>
      
      <p class="company-name">{pulqueLabsExperience.company}</p>
      <p class="experience-meta">
        <span>{pulqueLabsExperience.sector}</span>
        <span>{pulqueLabsExperience.period}</span>
        
      </p>
    </header>

    <p class="experience-introduction">{pulqueLabsExperience.introduction}</p>

    <div class="responsibilities">
      <h4>Responsabilidades</h4>
      <ul>
        {pulqueLabsExperience.responsibilities.map((responsibility) => (
          <li>{responsibility}</li>
        ))}
      </ul>
    </div>

    <div class="tools">
      <h4>Tecnologías y herramientas</h4>
      <div class="tool-groups">
        {pulqueLabsExperience.toolGroups.map((group) => (
          <div class="tool-group">
            <h5>{group.category}</h5>
            <ul aria-label={group.category}>
              {group.tools.map((tool) => <li>{tool}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </article>
</section>

<style>
  .content-section {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-border);
  }

  .experience-entry {
    margin-top: 2.5rem;
  }

  .experience-header h3 {
    margin: 0.55rem 0 0;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .company-name {
    margin: 1.15rem 0 0;
    font-size: var(--text-lg);
    font-weight: 550;
  }

  .experience-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .experience-meta span + span::before {
    margin-right: 1rem;
    color: var(--color-secondary);
    content: '·';
  }

  .experience-introduction {
    max-width: 58rem;
    margin: 1.75rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .responsibilities,
  .tools {
    margin-top: 2rem;
  }

  .responsibilities h4,
  .tools h4 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }

  .responsibilities ul {
    display: grid;
    gap: 0.65rem;
    margin: 0.85rem 0 0;
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  .responsibilities li {
    padding-left: 0.2rem;
  }

  .responsibilities li::marker {
    color: var(--color-accent);
  }

  .tool-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--component-gap);
    margin-top: 1rem;
  }

  .tool-group h5 {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .tool-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tool-group li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: rgb(11 83 81 / 16%);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  @media (max-width: 48rem) {
    .tool-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .experience-meta {
      flex-direction: column;
      gap: 0.15rem;
    }

    .experience-meta span + span::before {
      content: none;
    }

    .tool-groups {
      grid-template-columns: 1fr;
    }
  }
</style>

